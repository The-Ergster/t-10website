{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-10website",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled"
  "assets": {
    "directory": ".",
    "exclude": ["templates/**"],
    "run_worker_first": ["/api/*"]
  }
}
